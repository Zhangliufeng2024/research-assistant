# =============================================================================
# Research Assistant v3 — Environment Configuration
# =============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your keys below
# 3. Lines starting with # are ignored
# =============================================================================


# =============================================================================
# SECTION 1 — WRITING MODEL (required)
# =============================================================================
# Used ONLY by the core agentic writing loop (research_assistant/ package).
# Supports both Anthropic Messages API and OpenAI-compatible Chat Completions.
# Auto-detects provider from API key format (sk-ant-* = Anthropic, else OpenAI).
# Completely decoupled from image generation — changing this does NOT affect
# skill scripts (schematics, slides, infographics, etc.).
# These env vars must NOT be used by any image generation or review code.

# API key for your LLM provider
LLM_API_KEY=

# Provider: "anthropic" or "openai" (auto-detected from key if not set)
# LLM_PROVIDER=

# Base URL for the LLM API (optional, defaults per provider)
# Anthropic default: https://api.anthropic.com
# OpenAI-compatible default: https://api.openai.com
# LLM_BASE_URL=

# Model name (default: claude-sonnet-5 for Anthropic, gpt-4o for OpenAI)
# LLM_MODEL=claude-sonnet-5


# =============================================================================
# SECTION 2 — IMAGE GENERATION & REVIEW (completely decoupled)
# =============================================================================
# Used by ALL image generation and visual review code.
# Completely independent from the writing model in Section 1.
# Even if you use the same provider and API key, configure here separately.

# --- Primary image generation key ---
# Used by generate_image.py and all iterative pipeline scripts.
# Provider auto-detection: if key starts with "nvapi-", routes to NVIDIA NIM.
# Otherwise, uses OpenAI-compatible chat/completions endpoint.
IMAGE_API_KEY=

# --- Image generation endpoint ---
# Base URL for the image generation API (ignored for NVIDIA NIM).
# Default: https://apihub.agnes-ai.com/v1
# For agnes-image models, uses /images/generations endpoint automatically.
# For other models, uses /chat/completions endpoint.
# IMAGE_BASE_URL=https://apihub.agnes-ai.com/v1

# --- Image generation model ---
# Model used for image generation (default: agnes-image-2.0-flash).
# Models starting with "agnes-image" use /images/generations endpoint
# with return_base64=true (Agnes contract).
# Other models use OpenAI-compatible /chat/completions endpoint.
# IMAGE_MODEL=agnes-image-2.0-flash

# --- Visual review model ---
# Model used for quality review of generated images.
# Used by iterative pipeline scripts (schematics, infographics, slides).
# Default: agnes-2.0-flash
# IMAGE_REVIEW_MODEL=agnes-2.0-flash


# =============================================================================
# SECTION 3 — SEARCH & RESEARCH KEYS (optional)
# =============================================================================

# Parallel Chat API — web search and deep research
# https://www.parallel.ai/
PARALLEL_API_KEY=

# Parallel model (default: core)
# PARALLEL_MODEL=core

# Semantic Scholar — academic paper metadata
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex email — higher rate limits (free)
OPENALEX_EMAIL=

# Tavily — market data and news search
# https://tavily.com/
TAVILY_API_KEY=

# Search model (used by research-lookup for Perplexity/OpenRouter search)
# SEARCH_MODEL=


# =============================================================================
# SECTION 4 — RATE LIMITING (optional)
# =============================================================================

# Minimum interval (seconds) between writing model LLM API calls (default: 2)
# LLM_REQUEST_INTERVAL=2

# Minimum interval (seconds) between image generation API calls (default: 4)
# IMAGE_REQUEST_INTERVAL=4


# =============================================================================
# SECTION 5 — RELIABILITY TUNING (optional)
# =============================================================================

# Auto-continue: keep agent running until task is complete (default: true)
# RA_AUTO_CONTINUE=true

# Multi-agent mode: parallel research + figures + writing (default: false)
# RA_MULTI_AGENT=false

# Max retries on transient network errors (default: 3)
# RA_MAX_RETRIES=3

# Base delay in seconds between retries (default: 5)
# RA_RETRY_BASE_DELAY=5

# Seconds of silence before agent is considered "stuck" (default: 300)
# RA_HEARTBEAT_TIMEOUT=300
