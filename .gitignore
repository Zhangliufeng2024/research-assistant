# Python
__pycache__/
*.py[cod]
*.pyc
*$py.class
*.egg-info/
# 构建产物默认忽略；安装包 exe（<100MB）显式放行入库（R17：随仓库分发测试版）
dist/*
!dist/ResearchAssistant_setup_*.exe
build/
*.egg

# Virtual environment
.venv/
venv/
env/

# Environment variables (contains API keys)
.env

# Key-rotation env backups (real API keys inside) — never commit
.env.ra*

# Debug and logs
*.log
debug*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# pytest
.pytest_cache/
.ruff_cache/

# Writing outputs (generated at runtime)
writing_outputs/

# User data files (local only)
data/
existing_figures/

# LaTeX intermediate files
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.toc
*.synctex.gz

# Claude Code local state
.claude/plans/
.claude/memory/
.claude/settings.local.json
.claude/skills.zip

# Evaluation results (generated at runtime)
eval_results/

# Local research-assistant state
.ra/

# 产品在本仓库内运行时的临时脚本残留（run_python/bash 落在 cwd 的草稿）
_ra_exec_*.py

# build.py --restricted 的 PyInstaller 产物 spec（每次构建重新生成）
# R17 修正：原先 *.spec 全排与已入库的 ResearchAssistant.spec 自相矛盾——
# 只排除构建产物，主 spec 显式保留追踪。
ResearchAssistant_Trial.spec
!ResearchAssistant.spec

# 内部计划文档统一收 docs/plans/（R17 起 plan260824.md 已迁入，此条退役）

# pytest basetemp（避免误入 stash/提交）
.pytest_tmp*/
