# Python
__pycache__/
*.py[cod]
*.pyc
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environment
.venv/
venv/
env/

# Environment variables (contains API keys)
.env

# Key-rotation env backups (real API keys inside) — never commit
.env.ra*

# Debug and logs
*.log
debug*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# pytest
.pytest_cache/
.ruff_cache/

# Writing outputs (generated at runtime)
writing_outputs/

# User data files (local only)
data/
existing_figures/

# LaTeX intermediate files
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.toc
*.synctex.gz

# Claude Code local state
.claude/plans/
.claude/memory/
.claude/settings.local.json
.claude/skills.zip

# Evaluation results (generated at runtime)
eval_results/

# Local research-assistant state
.ra/

# 产品在本仓库内运行时的临时脚本残留（run_python/bash 落在 cwd 的草稿）
_ra_exec_*.py

# build.py --restricted 的 PyInstaller 产物 spec（每次构建重新生成）
ResearchAssistant_Trial.spec
*.spec

# 内部计划文档（防误入库）
plan260824.md

# pytest basetemp（避免误入 stash/提交）
.pytest_tmp*/
